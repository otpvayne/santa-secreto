# =============================================================================
# Santa Secreto — variables de entorno
# Copia este archivo como .env.local (local) y configura las mismas en Vercel.
# NUNCA subas .env.local al repositorio.
# =============================================================================

# --- Base de datos ------------------------------------------------------------
# Producción: cadena del "Transaction pooler" de Supabase (puerto 6543).
#   Supabase → Project → Connect → Transaction pooler
#   postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local sin credenciales (PostgreSQL embebido, solo para pruebas en tu computador):
#   DATABASE_URL=pglite:./.data/db
DATABASE_URL=pglite:./.data/db

# SSL hacia la base de datos: no-verify (por defecto, cifrado), verify (requiere DATABASE_CA_CERT) o disable.
# DATABASE_SSL=no-verify
# DATABASE_CA_CERT=

# --- Supabase (Storage y Realtime) --------------------------------------------
# Supabase → Project Settings → API Keys
# URL del proyecto (pública).
NEXT_PUBLIC_SUPABASE_URL=
# Clave "publishable" (sb_publishable_...). Es pública: solo sirve para escuchar señales de Realtime.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave "secret" (sb_secret_...). SOLO servidor. Nunca la pongas en una variable NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Bucket privado de fotografías (se crea con npm run db:migrate).
SUPABASE_PHOTO_BUCKET=participant-photos
